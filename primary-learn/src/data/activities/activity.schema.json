{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primary-learn/activity",
  "title": "Primary Maths activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "subject",
    "type",
    "yearGroups",
    "ability",
    "estimatedMinutes",
    "masteryThreshold",
    "curriculumRef",
    "pathNode",
    "difficulty",
    "questionCount",
    "difficultyRamp",
    "skills",
    "questions"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "subject": { "const": "maths" },
    "type": {
      "enum": ["counting", "number-bonds", "times-tables", "fractions", "place-value", "reasoning"]
    },
    "yearGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["Reception", "Year1", "Year2", "Year3", "Year4", "Year5", "Year6"]
      }
    },
    "ability": { "enum": ["emerging", "expected", "greater-depth"] },
    "estimatedMinutes": { "type": "number" },
    "masteryThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "curriculumRef": { "type": "string" },
    "pathNode": { "type": "string" },
    "difficulty": { "enum": [1, 2, 3] },
    "questionCount": { "type": "integer", "minimum": 8 },
    "difficultyRamp": {
      "type": "object",
      "required": ["within", "versus"],
      "properties": {
        "within": { "type": "string" },
        "versus": { "type": "string" }
      }
    },
    "skills": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
    "questions": { "type": "array", "minItems": 8 }
  }
}
